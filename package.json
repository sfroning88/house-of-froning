{
  "name": "house-of-froning",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "reactDoctor": {
    "ignore": {
      "rules": [
        "knip/exports"
      ],
      "files": [
        "**/generated/**",
        "**/.next/**",
        "node_modules/**",
        "**/dist/**"
      ]
    }
  },
  "dependencies": {
    "@packages/config": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "@vercel/speed-insights": "2.0.0",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "posthog-js": "1.433.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "sonner": "2.0.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
