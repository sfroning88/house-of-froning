{
  "name": "house-of-froning",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "reactDoctor": {
    "ignore": {
      "rules": [
        "knip/exports"
      ],
      "files": [
        "**/generated/**",
        "**/.next/**",
        "node_modules/**",
        "**/dist/**"
      ]
    }
  },
  "dependencies": {
    "@packages/config": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "posthog-js": "^1.360.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "sonner": "1.7.4",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
